.superpowers/

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
*.pyc
.coverage
.DS_Store

# results/ contents are gitignored except for a placeholder so the
# directory itself is tracked; H200 outputs land here and are large.
# ANALYSIS_LOG.md is also excepted (knobe/CLAUDE.md section 5): it's a small,
# append-only provenance log, not a data artifact.
results/*
!results/.gitkeep
!results/ANALYSIS_LOG.md
orca/

# Cluster-internal details — local-only, never push
scripts/cluster_connect.sh
configs/storage.yaml
docs/PILOT_G1_PROVENANCE.md
build/
*.bak

# Ngo-extension pilot curation/elicitation outputs are local-only (raw
# checkpoints, selected datasets, reports, results) -- only the base
# dataset CSVs are committed. Same rule as results/.
analysis/ngo_extensions/*/outputs/*_raw.jsonl*
analysis/ngo_extensions/*/outputs/*_selected.csv
analysis/ngo_extensions/*/outputs/selection_report.md
# Exception (2026-09-25): the final curation checkpoints and selection
# reports are published as provenance for the selected-item sets. The
# pre-retry *.v1.bak checkpoints and the *_selected.csv files stay local
# (the latter are reproducible via verify_curation_provenance.py).
!analysis/ngo_extensions/nonmoral_pilot/outputs/moral_relevance_raw.jsonl
!analysis/ngo_extensions/moral_foundations_pilot/outputs/foundation_relevance_raw.jsonl
!analysis/ngo_extensions/*/outputs/selection_report.md
analysis/ngo_extensions/*/outputs/power_check.csv
analysis/ngo_extensions/*/outputs/elicit_results.jsonl

# Cluster-platform code drops -- local-only, must never enter this repo
orca-main.zip
